# ==============================================================================
# ParamSathya Environment Configuration Template
# NOTE: DO NOT COMMIT REAL KEYS OR SECRETS TO GIT HISTORY.
# Use Google Secret Manager or Application Default Credentials in production.
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="ParamSathya"

# Google GenAI / Vertex AI Credentials
# In Cloud Run, ADC (Application Default Credentials) is used automatically.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Firebase / Firestore Setup
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private keys must be injected via Secret Manager, not committed
FIREBASE_PRIVATE_KEY=

# Storage
GCS_BUCKET_NAME=

# Sync Labs Integration (Reusable Base Video Asset Architecture)
SYNC_API_BASE_URL=https://api.sync.so/v2
# Rotate the exposed key, then place the replacement in .env.local or Secret Manager
SYNC_API_KEY=
# Existing approved cloned voice
SYNC_VOICE_ID=
# Filled by the one-time asset-upload script (scripts/register-sync-base-video.ps1)
SYNC_BASE_VIDEO_ASSET_ID=
# Keep both expensive operations disabled while developing
SYNC_TTS_ENABLED=false
SYNC_DEMO_GENERATION_ENABLED=false
# Generate locally via scripts/generate-commit-token.ps1
SYNC_DEMO_COMMIT_TOKEN=
SYNC_MODEL=lipsync-2-pro
SYNC_TTS_PROVIDER=elevenlabs
SYNC_TTS_STABILITY=0.50
SYNC_TTS_SIMILARITY_BOOST=0.75
SYNC_MAX_SCRIPT_CHARS=180
SYNC_MAX_AUDIO_SECONDS=8.5

# Capability Toggles
NEXT_PUBLIC_GUIDE_LIVE_ENABLED=false
NEXT_PUBLIC_GUIDE_PRESET_AVATAR_ENABLED=false
NEXT_PUBLIC_PRESENCE_MUSETALK_ENABLED=false
NEXT_PUBLIC_PRESENCE_REPLICATED_TTS_ENABLED=false
NEXT_PUBLIC_PRESENCE_VOICESTUDIO_ENABLED=false

# Contractual Restrictions: Hard Locked to false
NEXT_PUBLIC_GOOGLE_CUSTOM_LIVE_AVATAR_ENABLED=false
NEXT_PUBLIC_GOOGLE_CUSTOM_LIVE_VOICE_ENABLED=false
