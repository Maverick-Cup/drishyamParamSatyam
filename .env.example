# ==============================================================================
# ParamSathya Environment Configuration Template
# NOTE: DO NOT COMMIT REAL KEYS OR SECRETS TO GIT HISTORY.
# Use Google Secret Manager or Application Default Credentials in production.
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_NAME="ParamSathya"

# Google GenAI / Vertex AI Credentials
# In Cloud Run, ADC (Application Default Credentials) is used automatically.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Firebase / Firestore Setup
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private keys must be injected via Secret Manager, not committed
FIREBASE_PRIVATE_KEY=

# Storage
GCS_BUCKET_NAME=

# Capability Toggles
NEXT_PUBLIC_GUIDE_LIVE_ENABLED=false
NEXT_PUBLIC_GUIDE_PRESET_AVATAR_ENABLED=false
NEXT_PUBLIC_PRESENCE_MUSETALK_ENABLED=false
NEXT_PUBLIC_PRESENCE_REPLICATED_TTS_ENABLED=false
NEXT_PUBLIC_PRESENCE_VOICESTUDIO_ENABLED=false

# Contractual Restrictions: Hard Locked to false
NEXT_PUBLIC_GOOGLE_CUSTOM_LIVE_AVATAR_ENABLED=false
NEXT_PUBLIC_GOOGLE_CUSTOM_LIVE_VOICE_ENABLED=false
